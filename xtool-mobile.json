{
  "schemaVersion": 1,
  "name": "HyperDroidIOS",
  "bundleIdentifier": "com.hazerbvisor.hyperdroid.ios",
  "deploymentTarget": "16.0",
  "executableTarget": "HyperDroidIOS",
  "targets": [
    {
      "name": "HyperDroidIOS",
      "sources": [
        "Sources/HyperDroidIOS"
      ],
      "parseAsLibrary": false
    }
  ],
  "frameworks": [
    "Foundation",
    "SwiftUI",
    "UIKit",
    "WebKit",
    "AVFoundation",
    "MediaPlayer",
    "Network",
    "PhotosUI"
  ],
  "resources": [
    {
      "path": "Resources/hyperdroid_ui_atlas.png",
      "destination": "hyperdroid_ui_atlas.png"
    },
    {
      "path": "Resources/hyperdroid_default_wallpaper.jpg",
      "destination": "hyperdroid_default_wallpaper.jpg"
    }
  ],
  "infoPlist": "HyperDroidIOSInfo.plist",
  "shortVersion": "0.1.0",
  "buildVersion": "2",
  "reuseCompilerEngine": true,
  "reuseBundledRuntime": true
}
