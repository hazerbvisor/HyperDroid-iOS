{
  "schemaVersion": 1,
  "name": "HyperDroidIOS",
  "bundleIdentifier": "com.hazerbvisor.hyperdroid.ios",
  "deploymentTarget": "16.0",
  "executableTarget": "HyperDroidIOS",
  "targets": [
    {
      "name": "HyperDroidIOS",
      "sources": [
        "Sources/HyperDroidIOS"
      ],
      "parseAsLibrary": false
    }
  ],
  "frameworks": [
    "Foundation",
    "SwiftUI",
    "UIKit",
    "WebKit"
  ],
  "resources": [
    {
      "path": "Resources/hyperdroid_ui_atlas.png",
      "destination": "hyperdroid_ui_atlas.png"
    }
  ],
  "infoPlist": "HyperDroidIOSInfo.plist",
  "shortVersion": "0.1.0",
  "buildVersion": "1",
  "reuseCompilerEngine": true,
  "reuseBundledRuntime": true
}
